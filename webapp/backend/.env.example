# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://stochestimate:stochestimate_dev@localhost:5433/stochestimate_app

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_real_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave blank to print verification links to stdout (development mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@stochestimate.com

# ── Frontend URL (used in email links) ────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Research code (absolute path to repo root) ────────────────────────────────
RESEARCH_ROOT=/mnt/c/Users/vasiu/UBB/Info/Licenta/StochEstimate
LSTM_MODEL_PATH=estimation/saved_models/ou_lstm_v2_robust.pt

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=StochEstimate
DEBUG=true
